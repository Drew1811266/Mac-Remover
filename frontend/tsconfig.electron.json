{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist-electron",
    "rootDir": ".",
    "types": ["node", "vitest/globals"]
  },
  "include": ["electron/**/*.ts", "src/types/**/*.ts"],
  "exclude": ["dist-electron", "node_modules", "electron/**/*.test.ts"]
}
